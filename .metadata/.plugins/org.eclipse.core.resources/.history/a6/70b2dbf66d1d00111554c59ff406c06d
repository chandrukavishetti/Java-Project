package com.chandru.assignment_test.model;

public class Electronics extends Product{
	private String electronicProdName;
	
	public String Electronic(int id,String name,double price,String electronicProdName) {
		super(id,name,price);
		StudentValidator.validateName(electronicProdName);
		this.electronicProdName=electronicProdName;
	}
	@Override
	public void displayStudents() {
		System.out.println("id : "+getProductId);
		System.out.println("product name : "+getProductName);
		System.out.println("product base price : "+getProductPrice);
		System.out.println("electronic product name : "+electronicProductName);
	}

}

package com.chandru.string_assignment.model;

public class ProductCodeParserModel {
	
	private String input;
	
	public Product(String input) {
		this.input=input;
	}
	public void ProductCodeParser() {
		try {
			input=input.trim();
			String[] data=input.split("-");
			char delimiter='-';
			
			if(!input.contains("-")) {
				throw new Exception("the input should contains the '-' the symbol");
			}
			
			int index=input.indexOf("-");
			
			if(index==0 || index==input.length()-1) {
				throw new Exception("name cannot start and ends with this symbol '-' ");
			}
			
			String category=input.substring(0,index);
			
			String prodname=input.substring(index, delimiter);
			
			String manufature_year=input.substring(delimiter+1,input.length());
			
			String upper_case=input.toUpperCase();
			
		}catch(Exception e) {
			System.out.println("error : "+e.getMessage());
		}
	}

}

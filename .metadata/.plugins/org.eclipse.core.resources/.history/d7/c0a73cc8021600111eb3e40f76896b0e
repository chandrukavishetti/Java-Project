package com.chandru.mini_project.model;

import java.util.Scanner;

public class GameHandler {
    private final Scanner scanner = new Scanner(System.in);

    public int getValidInt(String message) {
        System.out.println(message);
        String input = scanner.next();
        try {
            return Integer.parseInt(input);
        } catch (NumberFormatException e) {
            System.out.println("Error: Only whole integers are allowed. No decimals, spaces, or letters.");
            return getValidInt(message); // Recursive call to retry
        }
    }

    public int getCellChoice(int maxSize) {
        int choice = getValidInt("Choose a cell (1-" + (maxSize * maxSize) + "):");
        if (choice < 1 || choice > (maxSize * maxSize)) {
            System.out.println("Out of bounds!");
            return getCellChoice(maxSize);
        }
        return choice;
    }
}
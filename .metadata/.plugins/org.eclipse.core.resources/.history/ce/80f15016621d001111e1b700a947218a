package com.chandru.assignment_test.model;

public class ProductValidator {
	public static void productIdValidator(int id) {
		if (0 >= id) {
			throw new IllegalArgumentException("id cannot be zero");
		}
	}

	public static void productNameValidator(String productName) {
		if (!productName.matches("[a-zA-Z]")) {
			throw new IllegalArgumentException("name should contains the alphabet only");
		}
		if (productName.trim().isEmpty() || productName == null) {
			throw new IllegalArgumentException("name cannot be null");
		}
	}

	public static void productBalaceValidator(double balance) {
		if (0 >= balance) {
			throw new IllegalArgumentException("id cannot be zero");
		}
	}

}

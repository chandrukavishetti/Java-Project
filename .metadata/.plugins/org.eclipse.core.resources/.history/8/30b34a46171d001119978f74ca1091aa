package com.chandru.assignment_test.model;

import java.util.Scanner;

public class StaffInputHandler {

	private Scanner scanner;

	public StaffInputHandler() {
		scanner = new Scanner(System.in);
	}

	public String getString(String message, String type) { // Added 'type' to know what to validate
	    while (true) {
	        try {
	            System.out.print(message);
	            String value = scanner.nextLine().trim();

	            // Immediate Validation
	            if (type.equalsIgnoreCase("name")) {
	                StaffValidator.validateName(value);
	            } else if (type.equalsIgnoreCase("dept")) {
	                StaffValidator.validateDepartment(value);
	            } else if (type.equalsIgnoreCase("spec")) {
	                StaffValidator.validateSpecialization(value);
	            }
	            
	            return value; // Only returns if validation passes
	        } catch (IllegalArgumentException e) {
	            System.out.println("Error: " + e.getMessage());
	        }
	    }
	}

	public int getInt(String message) {
	    while (true) {
	        try {
	            System.out.print(message);
	            int id = Integer.parseInt(scanner.nextLine());
	            StaffValidator.validateId(id); // Immediate ID check
	            return id;
	        } catch (NumberFormatException e) {
	            System.out.println("Error: Please enter a valid numeric number.");
	        } catch (IllegalArgumentException e) {
	            System.out.println("Error: " + e.getMessage());
	        }
	    }
	}	public int getShiftInt(String message) {
		while (true) {
			System.out.println(message);
			String input = scanner.nextLine();

			try {

				if (!input.matches("[1-3]")) {
					throw new IllegalArgumentException("Invalid input! Please enter only 1, 2, or 3.");
				}

				return Integer.parseInt(input);

			} catch (IllegalArgumentException e) {

				System.out.println(e.getMessage());
			}
		}
	}
}
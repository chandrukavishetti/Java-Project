package com.chandru.mini_project.model;

public class Board {
    private final int size;
    private final MarkType[][] grid;

    public Board(int size) {
        this.size = size;
        this.grid = new MarkType[size][size];
        initializeBoard();
    }

    private void initializeBoard() {
        for (int i = 0; i < size; i++) {
            for (int j = 0; j < size; j++) {
                grid[i][j] = MarkType.EMPTY;
            }
        }
    }

    public boolean placeMark(int cell, MarkType mark) {
        int row = (cell - 1) / size;
        int col = (cell - 1) % size;

        if (row < 0 || row >= size || col < 0 || col >= size) return false;
        if (grid[row][col] != MarkType.EMPTY) return false;

        grid[row][col] = mark;
        return true;
    }

    public void display() {
        int cellNum = 1;
        for (int i = 0; i < size; i++) {
            for (int j = 0; j < size; j++) {
                String val = (grid[i][j] == MarkType.EMPTY) ? String.valueOf(cellNum) : grid[i][j].toString();
                System.out.printf(" %2s |", val);
                cellNum++;
            }
            System.out.println("\n" + "------".repeat(size));
        }
    }


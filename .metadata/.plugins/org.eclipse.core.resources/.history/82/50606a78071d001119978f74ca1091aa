package com.chandru.assignment_test.test;

import com.chandru.assignment_test.model.ScholarshipStudent;
import com.chandru.assignment_test.model.StudentInputHandler;
import com.chandru.assignment_test.model.Student;
import com.chandru.assignment_test.model.StudentRepository;
import com.chandru.assignment_test.model.StudentService;
import com.chandru.assignment_test.model.RegularStudent;

public class StudentTest {

	public static void main(String[] args) {

		StudentInputHandler input = new StudentInputHandler();

		StudentRepository repository = new StudentRepository(10);

		StudentService service = new StudentService(repository);

		boolean running = true;

		while (running) {

			System.out.println("\nStudent Enrollment System");
			System.out.println("1 Add Regular Student");
			System.out.println("2 Add Scholarship Student");
			System.out.println("3 Display Students");
			System.out.println("4 Exit");

			int choice = input.getInt("Enter choice: ");

			try {

				switch (choice) {

				case 1:

					int id = input.getInt("Enter Student ID: ");
					String name = input.getString("Enter Name: ");
					String course = input.getString("Enter Course: ");

					Student regular = new RegularStudent(id, name, course);
					service.addStudent(regular);

					break;

				case 2:

					int sid = input.getInt("Enter Student ID: ");
					String sname = input.getString("Enter Name: ");
					String scourse = input.getString("Enter Course: ");
					double scholarship = input.getDouble("Enter Scholarship Amount: ");

					Student scholar = new ScholarshipStudent(sid, sname, scourse, scholarship);
					service.addStudent(scholar);

					break;

				case 3:

					service.displayStudents();
					break;

				case 4:

					running = false;
					System.out.println("Program Ended");
					break;

				default:

					System.out.println("Invalid choice");
				}

			} catch (IllegalArgumentException e) {

				System.out.println("Error: " + e.getMessage());
			}
		}
	}
}
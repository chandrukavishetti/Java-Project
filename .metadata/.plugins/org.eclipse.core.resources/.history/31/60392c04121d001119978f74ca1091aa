package com.chandru.assignment_test.model;

import java.util.Scanner;

public class StaffInputHandler {

	private Scanner scanner;

	public StaffInputHandler() {
		scanner = new Scanner(System.in);
	}

	public int getInt(String message) {

		while (true) {

			try {
				System.out.print(message);
				return Integer.parseInt(scanner.nextLine());

			} catch (NumberFormatException e) {
				System.out.println("Invalid number. Try again.");
			}
		}
	}

	public String getString(String message) {

		while (true) {

			System.out.print(message);
			String value = scanner.nextLine();

			if (!value.trim().isEmpty()) {
				return value;
			}

			System.out.println("Input cannot be empty.");
		}
	}

	public int getShiftInt(String message) {
		while (true) {
			System.out.println(message);
			String input = scanner.nextLine();

			try {

				if (!input.matches("[1-3]")) {
					throw new IllegalArgumentException("Invalid input! Please enter only 1, 2, or 3.");
				}

				return Integer.parseInt(input);

			} catch (IllegalArgumentException e) {

				System.out.println(e.getMessage());
			}
		}
	}
}
package com.chandru.assignment_test.model;

public class StudentValidator {

	public static void validateId(int id) {

		if (id <= 0) {
			throw new IllegalArgumentException("Invalid Student ID");
		}
	}

	public static void validateName(String name) {

		if (name == null || name.trim().isEmpty()) {
			throw new IllegalArgumentException("Invalid Name");
		}
	}

	public static void validateCourse(String course) {

		if (course == null || course.trim().isEmpty()) {
			throw new IllegalArgumentException("Invalid Course");
		}
	}

	public static void validateScholarship(double amount) {

		if (amount < 0) {
			throw new IllegalArgumentException("Invalid Scholarship Amount");
		}
	}
}